{
  "name": "grooming-studio",
  "version": "0.1.0",
  "description": "Website for a pet grooming studio in Omsk, Russia.",
  "author": "Ruslan Khasanshin",
  "repository": "https://github.com/hu553in/grooming-studio",
  "homepage": "https://xn-----flcj2bnpjd0gcb.xn--p1ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "prettier -u -c . && eslint --cache --cache-location .cache/eslint --cache-strategy content --max-warnings 0 . && stylelint --max-warnings 0 --ignore-path .gitignore '**/*.css'",
    "lint:fix": "prettier -u -w . && eslint --cache --cache-location .cache/eslint --cache-strategy content --max-warnings 0 --fix . && stylelint --max-warnings 0 --fix --ignore-path .gitignore '**/*.css'",
    "check:hooks": "lefthook validate",
    "check:workflows": "bunx github-actionlint",
    "check:renovate": "bunx --package renovate renovate-config-validator --strict --no-global renovate.json",
    "check:types": "tsc --pretty",
    "check:unused": "knip",
    "check:vulns": "bun audit --prod --audit-level=high",
    "check": "bun lint && bun check:hooks && bun check:workflows && bun check:renovate && bun check:types && bun run build && bun check:unused && bun check:vulns && bun test:coverage",
    "check:fix": "bun lint:fix && bun check",
    "test": "vitest run",
    "test:coverage": "bun run test --coverage",
    "prepare": "if [ -n \"${CI:-}\" ] || [ \"${LEFTHOOK:-}\" = \"0\" ]; then exit 0; fi; lefthook install"
  },
  "dependencies": {
    "cn": "^0.2.4",
    "embla-carousel-react": "^8.6.0",
    "photoswipe": "^5.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/yandex-metrika-tag": "^2.0.7",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.26",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.9.0",
    "knip": "^6.32.0",
    "lefthook": "^2.1.10",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.4.0"
}
